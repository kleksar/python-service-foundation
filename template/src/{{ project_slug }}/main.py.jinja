"""FastAPI application and Uvicorn entrypoint."""

import logging
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import uvicorn
from fastapi import FastAPI

from .health import router as health_router
from .logging_config import configure_logging
from .settings import get_settings
{% if use_postgres %}from .database import dispose_engine
{% endif %}

logger = logging.getLogger(__name__)


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncIterator[None]:
    """Own resources that need deterministic process shutdown."""

    yield
{% if use_postgres %}
    await dispose_engine()
{% endif %}


def create_app() -> FastAPI:
    """Build the intentionally small HTTP service."""

    settings = get_settings()
    configure_logging(settings.log_level)
    app = FastAPI(title=settings.service_name, lifespan=lifespan)
    app.include_router(health_router)
    logger.info("application configured")
    return app


app = create_app()


def run() -> None:
    """Run the application with Uvicorn for local and container use."""

    settings = get_settings()
    uvicorn.run(app, host=settings.host, port=settings.port, log_config=None)
