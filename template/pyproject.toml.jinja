[build-system]
requires = ["hatchling>=1.26"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.2.0"
description = "Minimal FastAPI service generated by Python Service Foundation"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
  "fastapi>=0.115,<1.0",
  "pydantic-settings>=2.7,<3.0",
  "uvicorn[standard]>=0.34,<1.0",
{% if use_postgres %}
  "alembic>=1.14,<2.0",
  "asyncpg>=0.30,<1.0",
  "sqlalchemy[asyncio]>=2.0,<3.0",
{% endif %}
]

[dependency-groups]
dev = [
  "httpx>=0.28,<1.0",
  "pyright>=1.1.390,<2.0",
  "pytest>=8.3,<9.0",
  "ruff>=0.9,<1.0",
]

[project.scripts]
{{ project_slug }} = "{{ project_slug }}.main:run"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py313"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.pyright]
include = ["src"]
pythonVersion = "3.13"
typeCheckingMode = "strict"
reportMissingTypeStubs = false
