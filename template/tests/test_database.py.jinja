{% if use_postgres %}
"""Database readiness behavior for the PostgreSQL profile."""

import asyncio
import socket
from collections.abc import Callable
from typing import Any

import asyncpg
import pytest
from sqlalchemy.exc import SQLAlchemyError

from {{ project_slug }} import database


class FailingConnectionContext:
    """Raise a controlled dependency failure while acquiring a connection."""

    def __init__(self, error: Exception) -> None:
        self.error = error

    async def __aenter__(self) -> Any:
        raise self.error

    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: Any,
    ) -> None:
        return None


class FailingEngine:
    """Minimal async-engine double used to exercise the readiness boundary."""

    def __init__(self, error: Exception) -> None:
        self.error = error

    def connect(self) -> FailingConnectionContext:
        return FailingConnectionContext(self.error)


@pytest.mark.parametrize(
    ("error_factory", "expected_exception"),
    [
        (lambda: SQLAlchemyError("database unavailable"), SQLAlchemyError),
        (lambda: OSError("connection refused"), OSError),
        (lambda: socket.gaierror("database hostname unavailable"), socket.gaierror),
        (
            lambda: asyncpg.PostgresConnectionError("driver connection failed"),
            asyncpg.PostgresConnectionError,
        ),
        (lambda: asyncpg.InvalidPasswordError("authentication failed"), asyncpg.InvalidPasswordError),
    ],
)
def test_database_readiness_returns_false_for_dependency_failures(
    monkeypatch: pytest.MonkeyPatch,
    error_factory: Callable[[], Exception],
    expected_exception: type[Exception],
) -> None:
    """Availability, DNS, driver, and authentication faults mean not ready."""

    error = error_factory()
    assert isinstance(error, expected_exception)
    monkeypatch.setattr(database, "engine", FailingEngine(error))

    assert asyncio.run(database.database_is_ready()) is False


def test_database_readiness_does_not_hide_programming_errors(monkeypatch: pytest.MonkeyPatch) -> None:
    """Unexpected application failures remain observable to the caller."""

    monkeypatch.setattr(database, "engine", FailingEngine(TypeError("template bug")))

    with pytest.raises(TypeError, match="template bug"):
        asyncio.run(database.database_is_ready())
{% endif %}
